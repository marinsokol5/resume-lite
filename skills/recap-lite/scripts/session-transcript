#!/usr/bin/env python3
"""
session-transcript

Parse Claude Code or Codex session JSONLs and emit a *light* markdown transcript:
just the human <-> assistant back-and-forth, with a compact note of which
tools ran and what they touched (files read/edited, URLs fetched, ...).
Plan-mode plans (Claude's ExitPlanMode, Codex's proposed plan) get their own
`## 📋 Plan` sections. No LLM, no tokens, ~instant.

Two modes:
    convo+tools (default) — user <-> assistant text + a `🔧 tools:` trace
                            that names each tool and its target.
    convo-only (--no-tools) — just the human <-> assistant text.

Usage:
    session-transcript                        # list this project's sessions, then exit
    session-transcript <sessionId> [...]      # write ONE transcript file
                                              # (`this` = the session you're in)
        [--deep]                 # also include what these resumed from
        [--save]                 # keep it in the project (see below)
        [--out|--to <path>]      # override output path (a dir gets the --save name)
        [--topic TEXT]           # name a kept transcript after TEXT
        [--tools | --no-tools]   # show/hide the tool trace (default: show)
        [--stdout]               # also print the transcript to stdout
        [--messages M]           # keep each session's first and last M messages
    session-transcript --recent N             # this project's N most recent sessions
        [--provider claude|codex] [--exclude <id>|this ...]  # in ONE file

Sessions are scoped to the current directory. Pass no argument to list Claude
Code and Codex sessions together, newest first by last activity (provider · id
· time of its last message · first prompt); re-run with a chosen id. With an
id, the storage location determines the provider.

Several ids are stitched into a single file, in the order given, each session
under its own heading — one conversation continued across sessions stays one
thing to read.

--deep finds those earlier sessions for you: a chat started with
`/resume-lite <id>` (Codex: `$resume-lite <id>`) records where it came from, so
the chain can be walked backwards, transitively and across providers. Name the
newest chat and get the whole conversation, rendered oldest-first.

Default output is throwaway, under the OS temp dir:
    $TMPDIR/session-transcript/<sessionId>/summary.md    # one id
    $TMPDIR/session-transcript/<id1+id2+...>-<hash>/combined.md  # several ids

--save instead writes a keepable transcript into the project, named to be
recognizable in a repo listing (and committed):
    transcripts/<date>-<opening prompt>.md
(saving the same session(s) again overwrites it; a different one with the
same name takes -2, -3, ...)

--out (alias --to) takes a file path as the exact name. A directory (one that
exists, or a path ending in a separator, which is created) gets that --save
name inside it. Either way the transcript is a keepable export: its header
drops the "continue the work" line meant for resuming.

`this` stands for the current session: the script reads CODEX_THREAD_ID (set
by Codex) or CLAUDE_CODE_SESSION_ID (set by Claude Code's Bash) from its
environment, and exits non-zero if neither is set.

--recent N recaps instead of resuming: the N most recent sessions here (both
providers, newest first by last activity, minus any --exclude and sessions
that only ran this skill family), one file under
    $TMPDIR/session-transcript/recent-<id1+id2+...>-<hash>/recent.md
--messages M keeps only each session's first and last M messages (a message
is a user prompt, or the assistant's whole reply to it); trimmed temp files
are named `-m<M>`.

The output file path is printed to stdout as the last line.
"""

from __future__ import annotations

import argparse
import datetime
import glob
import hashlib
import json
import os
import re
import shlex
import sys
import tempfile
import unicodedata
from pathlib import Path
from typing import NamedTuple

CLAUDE_PROJECTS_DIR = Path.home() / ".claude" / "projects"
CODEX_HOME = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
CODEX_SESSION_DIRS = (CODEX_HOME / "sessions", CODEX_HOME / "archived_sessions")
# Default under the OS temp dir (honors $TMPDIR) so it's writable even under
# Claude Code's Bash sandbox, which blocks arbitrary /tmp paths.
OUT_ROOT = Path(tempfile.gettempdir()) / "session-transcript"
# --save writes here instead, relative to the project dir the script is run
# from, so the transcript can be committed alongside the work it describes.
SAVE_DIR = "transcripts"

# Text blocks that are harness plumbing, not real conversation.
_SKIP_PREFIXES = ("<command-name>", "<local-command-stdout>", "<command-message>")
_CAVEAT = "Caveat: The messages below were generated"
# Standalone interrupt markers (matched exactly so a real prompt appended in the
# same message is never dropped).
_INTERRUPT_MARKERS = frozenset({
    "[Request interrupted by user]",
    "[Request interrupted by user for tool use]",
})
# Records the harness injects but that aren't conversation carry `isMeta: true`:
# `/context` dumps, `Base directory for this skill:`, local-command caveats, and
# "Continue from where you left off." continuations. Real prompts never do. We
# drop them wholesale rather than pattern-match each text shape (forward-compatible).


def encode_cwd(path: str) -> str:
    """Mirror Claude Code's project-dir encoding: non-alnum -> '-'."""
    return "".join(c if c.isalnum() else "-" for c in path)


def claude_project_dir() -> Path:
    """The current directory's Claude Code project storage dir."""
    return CLAUDE_PROJECTS_DIR / encode_cwd(os.getcwd())


def _codex_session_files():
    """Yield active and archived Codex JSONL files without duplicating symlinks."""
    seen = set()
    for root in CODEX_SESSION_DIRS:
        if not root.is_dir():
            continue
        for path in root.rglob("*.jsonl"):
            key = str(path.resolve())
            if key not in seen:
                seen.add(key)
                yield path


def _lines(path: Path):
    """A file's lines, closing it even when the caller stops early."""
    with path.open(encoding="utf-8") as stream:
        yield from stream


def _detect_provider(path: Path) -> str:
    """Detect a provider from the first recognizable JSONL record."""
    try:
        for i, line in enumerate(_lines(path)):
            if i >= 50:
                break
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            typ = record.get("type")
            if typ == "session_meta" and isinstance(record.get("payload"), dict):
                return "codex"
            if typ in ("user", "assistant") and isinstance(record.get("message"), dict):
                return "claude"
    except OSError as exc:
        sys.exit(f"cannot read session file '{path}': {exc}")
    sys.exit(f"cannot detect session format for '{path}'")


def _session_matches(path: Path, sid: str, provider: str) -> bool:
    stem = path.stem
    if provider == "claude":
        return stem == sid
    return stem == sid or stem.endswith(f"-{sid}")


def session_hits(session: str) -> tuple[str, list[tuple[Path, str]]]:
    """Every stored session matching an id (or path), with its provider.

    Non-fatal: --deep walks ids found inside transcripts, where a dead or
    ambiguous reference should be skipped rather than kill the whole run.
    """
    supplied = Path(session).expanduser()
    if supplied.is_file():
        return supplied.name, [(supplied, _detect_provider(supplied))]

    sid = supplied.name
    if sid.endswith(".jsonl"):
        sid = sid[:-6]

    hits: list[tuple[Path, str]] = []
    current = claude_project_dir() / f"{sid}.jsonl"
    if current.is_file():
        hits.append((current, "claude"))
    if CLAUDE_PROJECTS_DIR.is_dir():
        for path in CLAUDE_PROJECTS_DIR.rglob("*.jsonl"):
            if path != current and _session_matches(path, sid, "claude"):
                hits.append((path, "claude"))
    for path in _codex_session_files():
        if _session_matches(path, sid, "codex"):
            hits.append((path, "codex"))

    unique: list[tuple[Path, str]] = []
    seen = set()
    for path, provider in hits:
        key = str(path.resolve())
        if key not in seen:
            seen.add(key)
            unique.append((path, provider))
    return sid, unique


_ID_TAIL_RE = re.compile(
    r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z", re.I)
# A short id as recaps and --deep print it (id8), or any longer piece of one.
_ID_PREFIX_RE = re.compile(r"[0-9a-f][0-9a-f-]{7,35}", re.I)


def _stored_id(path: Path) -> str:
    """The session id a store's file name carries (Codex: after the timestamp)."""
    match = _ID_TAIL_RE.search(path.stem)
    return match.group(0).lower() if match else path.stem


def _prefix_hits(prefix: str) -> list[tuple[Path, str]]:
    """Every stored session whose id starts with `prefix`, any project."""
    prefix = prefix.lower()
    hits: list[tuple[Path, str]] = []
    if CLAUDE_PROJECTS_DIR.is_dir():
        hits += [(path, "claude") for path in CLAUDE_PROJECTS_DIR.rglob("*.jsonl")
                 if path.stem.lower().startswith(prefix)]
    hits += [(path, "codex") for path in _codex_session_files()
             if _stored_id(path).startswith(prefix)]
    unique, seen = [], set()
    for path, provider in hits:
        if str(path.resolve()) not in seen:
            seen.add(str(path.resolve()))
            unique.append((path, provider))
    return unique


def _in_this_project(path: Path, provider: str) -> bool:
    if provider == "claude":
        return path.parent == claude_project_dir()
    cwd = _codex_meta(path).get("cwd")
    return isinstance(cwd, str) and _same_directory(cwd, os.getcwd())


def _narrow_prefix_hits(hits: list[tuple[Path, str]]) -> list[tuple[Path, str]]:
    """Several sessions start with one short id (Codex ids are time-based, so
    ~1 in 10 id8s collide): prefer the user's own threads over Codex side
    threads, then this project's sessions, before calling it ambiguous."""
    for keep in (lambda path, provider: provider != "codex"
                 or not _codex_side_thread(_codex_meta(path)),
                 _in_this_project):
        if len(hits) > 1:
            hits = [hit for hit in hits if keep(*hit)] or hits
    return hits


def resolve_reference(reference: str) -> list[tuple[Path, str]]:
    """Sessions an id names: the exact id, else the session(s) a short id
    (8+ characters) starts, narrowed by _narrow_prefix_hits."""
    sid, hits = session_hits(reference)
    if not hits and _ID_PREFIX_RE.fullmatch(sid):
        hits = _narrow_prefix_hits(_prefix_hits(sid))
    return hits


def find_session_file(session: str) -> tuple[Path, str]:
    """Locate a session by id and infer its provider from the matching store.

    No exact match: an id prefix of 8+ characters (the short id a recap
    shows) names the one session it starts, and lists them if it starts
    several that _narrow_prefix_hits can't tell apart.
    """
    sid, unique = session_hits(session)
    prefix = not unique and bool(_ID_PREFIX_RE.fullmatch(sid))
    if prefix:
        unique = resolve_reference(sid)
    if not unique:
        roots = f"{CLAUDE_PROJECTS_DIR} or {CODEX_HOME / 'sessions'}"
        hint = (" (a short id needs at least 8 characters)"
                if re.fullmatch(r"[0-9a-f-]{1,7}", sid, re.I) else "")
        sys.exit(f"session '{sid}' not found under {roots}{hint}")
    if len(unique) > 1:
        matches = "\n".join(f"  {provider}: {_stored_id(path)}  {path}"
                            for path, provider in unique)
        what = "id prefix" if prefix else "id"
        sys.exit(f"session {what} '{sid}' is ambiguous:\n{matches}")
    return unique[0]


def _text_content(msg: dict) -> str | None:
    """A Claude message's text, its text blocks joined."""
    content = msg.get("content")
    if isinstance(content, list):
        content = "\n".join(b.get("text", "") for b in content
                            if isinstance(b, dict) and b.get("type") == "text")
    return content if isinstance(content, str) else None


def _command_name(msg: dict) -> str | None:
    """If a Claude user message is a slash-command invocation, return '/name'."""
    content = _text_content(msg)
    if content is None:
        return None
    m = re.search(r"<command-name>\s*(/[^<\s]+)", content)
    return m.group(1) if m else None


# A user message that is only a command invocation, e.g. `$resume-lite <id>`.
_INVOCATION_ONLY_RE = re.compile(r"\A[/$][A-Za-z0-9_.:-]+(?:\s+[0-9a-fA-F-]{6,36})*\Z")


def first_user_snippet(path: Path, provider: str, limit: int = 72,
                       skip_commands: bool = False) -> str:
    """First user prompt in a session, for the listing. Reads only until found.

    If the session opens with a slash command, surface its name (e.g.
    `/resume-lite`) rather than skipping to a later typed prompt — unless
    skip_commands, where the caller wants what the session was *about* (naming
    a file to keep), and `/resume-lite <id>` says nothing about that.
    """
    fallback = ""
    try:
        for line in _lines(path):
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except json.JSONDecodeError:
                continue
            queued = queued_prompt(r) if provider == "claude" else None
            if queued:  # the first prompt was typed while Claude worked
                return _short(queued, limit)
            if provider == "claude" and r.get("type") == "user" \
                    and not r.get("isSidechain") and not r.get("isMeta") \
                    and not _harness_origin(r) and isinstance(r.get("message"), dict):
                cmd = _command_name(r["message"])
                if cmd:
                    if not skip_commands:
                        return cmd
                    fallback = fallback or cmd
                    continue
                txt = user_text(r["message"])
                if txt:
                    return _short(txt, limit)
            payload = r.get("payload")
            if provider != "codex" or not isinstance(payload, dict):
                continue
            txt = None
            if r.get("type") == "event_msg" and payload.get("type") == "user_message":
                txt = payload.get("message")
            elif r.get("type") == "response_item" and payload.get("type") == "message" \
                    and payload.get("role") == "user":
                txt = _codex_typed_text(payload)  # rollouts without user_message
            if isinstance(txt, str) and txt.strip():
                txt = _plain_mentions(txt.strip())
                if skip_commands and (_INVOCATION_ONLY_RE.match(txt)
                                      or _family_invocation(txt)):
                    fallback = fallback or _short(txt, limit)
                    continue
                return _short(txt, limit)
    except OSError:
        pass
    return fallback


def _codex_meta(path: Path) -> dict:
    """Read the small session_meta record at the start of a Codex rollout."""
    try:
        for i, line in enumerate(_lines(path)):
            if i >= 50:
                break
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if record.get("type") == "session_meta" and isinstance(record.get("payload"), dict):
                return record["payload"]
    except OSError:
        pass
    return {}


def _same_directory(left: str, right: str) -> bool:
    try:
        return os.path.realpath(left) == os.path.realpath(right)
    except (OSError, TypeError):
        return False


def _codex_side_thread(meta: dict) -> bool:
    """A thread Codex spawned for itself (a subagent, a guardian review), not
    one the user talked in. A user's own fork (`forked_from_id` alone) stays."""
    source = meta.get("source")
    return (meta.get("thread_source") in ("subagent", "guardian_review")
            or (isinstance(source, dict) and ("subagent" in source
                                              or "thread_spawn" in source))
            or bool(meta.get("parent_thread_id")))


def list_sessions() -> list[tuple[Path, str, str]]:
    """This project's Claude and Codex sessions, newest first by last activity
    (see last_activity: a reopened old chat's mtime moves, its records don't)."""
    sessions: list[tuple[Path, str, str]] = []
    for f in glob.glob(str(claude_project_dir() / "*.jsonl")):
        path = Path(f)
        sessions.append((path, "claude", path.stem))
    for path in _codex_session_files():
        meta = _codex_meta(path)
        cwd, sid = meta.get("cwd"), meta.get("id")
        if isinstance(cwd, str) and isinstance(sid, str) \
                and _same_directory(cwd, os.getcwd()) and not _codex_side_thread(meta):
            sessions.append((path, "codex", sid))  # side threads: by id only
    sessions.sort(key=lambda item: last_activity(item[0]), reverse=True)
    return sessions


def _record_moment(line: bytes) -> float | None:
    """A JSONL record's `timestamp` as epoch seconds, if it has a valid one."""
    try:
        record = json.loads(line)
        stamp = record.get("timestamp") if isinstance(record, dict) else None
        if not isinstance(stamp, str) or not stamp:
            return None
        moment = datetime.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.timezone.utc)
    return moment.timestamp()


def _lines_backwards(stream, step: int = 1 << 16):
    """A binary file's lines, last first, each read and joined only once."""
    pos = stream.seek(0, os.SEEK_END)
    later: list[bytes] = []  # pieces of a line with no start found yet, newest first
    while pos > 0:
        size = min(step, pos)
        pos -= size
        stream.seek(pos)
        chunk = stream.read(size)
        if b"\n" not in chunk and pos > 0:
            later.append(chunk)  # still inside one long line: just collect
            continue
        lines = (chunk + b"".join(reversed(later))).split(b"\n")
        later = [lines.pop(0)] if pos > 0 else []  # its start is further back
        yield from reversed(lines)


def _local_time(moment: float, zone: bool = True) -> str:
    """An epoch time as local `YYYY-MM-DD HH:MM` (plus the zone's name)."""
    if moment == float("-inf"):
        return "unknown"
    local = datetime.datetime.fromtimestamp(moment).astimezone()
    return local.strftime("%Y-%m-%d %H:%M %Z" if zone else "%Y-%m-%d %H:%M").strip()


def last_activity(path: Path) -> float:
    """When the session last had a timestamped record (epoch seconds).

    Not the file's mtime: harnesses append untimestamped bookkeeping to old
    sessions (Claude Code's desktop app adds `bridge-session` records when it
    reopens one), which would pass a month-old chat off as the newest. Reads
    backwards from the end, so a long session costs one small read.
    """
    try:
        with path.open("rb") as stream:
            for line in _lines_backwards(stream):
                moment = _record_moment(line)
                if moment is not None:
                    return moment
        return path.stat().st_mtime
    except OSError:
        return float("-inf")


def load_records(path: Path) -> list[dict]:
    out = []
    for line in _lines(path):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


# Claude Code files some of its own text inside user turns: background-task
# notices, reminders, hook output. Each is cut only in the shape it's written
# in (a whole block, opening a line, closed), so the same tags typed or pasted
# by the user stay.
_CLAUDE_INJECTED_TAGS = ("task-notification", "system-reminder",
                         "user-prompt-submit-hook", "local-command-caveat")
_CLAUDE_INJECTED_RE = re.compile(
    rf"^[ \t]*<({'|'.join(map(re.escape, _CLAUDE_INJECTED_TAGS))})(?:\s[^>\n]*)?>"
    r".*?</\1>[ \t]*(?=\n|\Z)", re.DOTALL | re.MULTILINE)
# The user's own `!command`, with its output (dropped, like any tool output).
_CLAUDE_BASH_RE = re.compile(
    r"^[ \t]*<bash-input>(.*?)</bash-input>"
    r"(?:\s*<(bash-stdout|bash-stderr)>.*?</\2>)*", re.DOTALL | re.MULTILINE)


def _harness_origin(record: dict) -> bool:
    """A user record Claude Code delivered itself (a task notice, a message from
    another session), not one the user typed."""
    origin = record.get("origin")
    return isinstance(origin, dict) and origin.get("kind") not in (None, "human")


def user_text(msg: dict) -> str | None:
    """Real user prompt text, or None if this is a tool-result carrier / plumbing."""
    content = msg.get("content")
    if isinstance(content, str):
        text = content
    elif isinstance(content, list):
        parts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text"]
        if not parts:  # list with only tool_result / images -> not a prompt
            return None
        text = "\n".join(parts)
    else:
        return None
    text = _CLAUDE_INJECTED_RE.sub("", text)
    text = _CLAUDE_BASH_RE.sub(lambda m: "!" + m.group(1).strip(), text).strip()
    if not text or text.startswith(_SKIP_PREFIXES) or text.startswith(_CAVEAT) \
            or text in _INTERRUPT_MARKERS:
        return None
    return text


def queued_prompt(record: dict) -> str | None:
    """What the user typed while Claude was working: Claude Code files it as a
    `queued_command` attachment, often with no user record of its own."""
    attachment = record.get("attachment")
    if record.get("type") != "attachment" or record.get("isSidechain") \
            or not isinstance(attachment, dict) \
            or attachment.get("type") != "queued_command" \
            or attachment.get("commandMode") != "prompt":
        return None
    origin, prompt = attachment.get("origin"), attachment.get("prompt")
    if isinstance(origin, dict):
        if origin.get("kind") != "human":
            return None  # a task notice, or a message from another session
    elif isinstance(prompt, str) and prompt.lstrip().startswith(
            ("<task-notification>", "<agent-message")):
        return None  # older Claude Code files no origin: tell by the shape
    return user_text({"content": prompt})


def _short(s: str, n: int = 48) -> str:
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


def _json_object(value) -> dict:
    if isinstance(value, dict):
        return value
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
        except json.JSONDecodeError:
            return {}
        return parsed if isinstance(parsed, dict) else {}
    return {}


def _target_name(value: str) -> str:
    value = str(value).strip().strip("'\"").rstrip("/)")
    return os.path.basename(value) or value


def _patch_labels(patch: str) -> list[str]:
    """Extract exact file operations from an apply_patch payload."""
    verbs = {"Add": "Write", "Update": "Edit", "Delete": "Delete"}
    labels = []
    for action, path in re.findall(
            r"^\*\*\* (Add|Update|Delete) File: (.+)$", patch, re.MULTILINE):
        labels.append(f"{verbs[action]}({_short(_target_name(path))})")
    return list(dict.fromkeys(labels))


def tool_label(name: str, inp: dict | None) -> str:
    """Compact `Tool(target)` label — names what the call touched, not its output."""
    inp = inp or {}

    def g(*keys):
        for k in keys:
            v = inp.get(k)
            if v:
                return v
        return None

    if name in ("Read", "Edit", "Write", "NotebookEdit"):
        fp = g("file_path", "notebook_path")
        return f"{name}({_short(os.path.basename(str(fp).rstrip('/')) or fp)})" if fp else name
    if name == "Bash":
        d = g("description")
        return f"Bash({_short(d)})" if d else name
    if name == "write_stdin":
        session_id = g("session_id")
        return f"write_stdin(session {session_id})" if session_id else name
    if name == "view_image":
        path = g("path")
        return f"view_image({_short(os.path.basename(str(path)))})" if path else name
    if name == "WebFetch":
        u = g("url")
        return f"WebFetch({_short(str(u).split('://', 1)[-1])})" if u else name
    if name == "WebSearch":
        q = g("query")
        return f"WebSearch({_short(q)})" if q else name
    if name in ("Grep", "Glob"):
        p = g("pattern")
        return f"{name}({_short(p)})" if p else name
    if name in ("Task", "Agent"):
        s = g("subagent_type", "description")
        return f"Task({_short(s)})" if s else name
    if name == "Skill":
        s = g("skill")
        return f"Skill({_short(s)})" if s else name
    target = g("file_path", "path", "url", "query", "pattern", "ref_id", "location")
    if target:
        return f"{name}({_short(target)})"
    return name


_CODEX_CONTROL_TOOLS = {
    "create_goal", "get_goal", "request_user_input", "request_user_input_async",
    "update_goal", "update_plan", "wait", "write_stdin",
}
_SHELL_SKIP = {
    "[", "]", "basename", "cut", "dirname", "do", "done", "echo", "else", "exit",
    "fi", "for", "if", "printf", "pwd", "sort", "test", "then", "tr", "true",
    "uniq", "while", "xargs",
}


def _shell_segments(command: str) -> list[str]:
    """Split shell source on unquoted control operators; this is not an executor."""
    segments, buf = [], []
    quote = None
    escaped = False
    i = 0
    while i < len(command):
        ch = command[i]
        if escaped:
            buf.append(ch)
            escaped = False
        elif ch == "\\" and quote != "'":
            buf.append(ch)
            escaped = True
        elif quote:
            buf.append(ch)
            if ch == quote:
                quote = None
        elif ch in "'\"`":
            quote = ch
            buf.append(ch)
        elif ch in "\n;|" or command.startswith("&&", i) or command.startswith("||", i):
            segment = "".join(buf).strip()
            if segment:
                segments.append(segment)
            buf = []
            if command.startswith(("&&", "||"), i):
                i += 1
        else:
            buf.append(ch)
        i += 1
    segment = "".join(buf).strip()
    if segment:
        segments.append(segment)
    return segments


def _shell_tokens(segment: str) -> list[str]:
    try:
        return shlex.split(segment, comments=False, posix=True)
    except ValueError:
        return segment.split()


def _plain_args(tokens: list[str]) -> list[str]:
    return [token for token in tokens if token and not token.startswith("-")
            and not re.match(r"^\d*[<>]", token) and token not in ("(", ")")]


def _read_labels(exe: str, tokens: list[str]) -> list[str]:
    args = tokens[1:]
    targets: list[str] = []
    if exe == "sed":
        positional = _plain_args(args)
        targets = positional[1:]  # first positional is the sed expression
    elif exe in ("cat", "file", "wc"):
        targets = _plain_args(args)
    elif exe in ("head", "tail"):
        targets = [arg for arg in _plain_args(args) if not arg.isdigit()]
    labels = [f"Read({_short(_target_name(path))})" for path in targets
              if path not in ("-", "/dev/null") and not path.startswith("$(")]
    return list(dict.fromkeys(labels))


def _search_labels(exe: str, tokens: list[str]) -> list[str]:
    args = tokens[1:]
    if exe == "rg" and "--files" in args:
        scopes = [_target_name(arg) for arg in _plain_args(args)
                  if "/" in arg and not arg.startswith("$(")]
        return [f"List({_short(scopes[-1])})"] if scopes else ["List(files)"]

    value_options = {
        "-A", "-B", "-C", "-e", "-f", "-g", "-t", "--after-context",
        "--before-context", "--context", "--glob", "--iglob", "--type",
    }
    positional = []
    skip_next = False
    for arg in args:
        if skip_next:
            skip_next = False
            continue
        if arg in value_options:
            skip_next = True
        elif not arg.startswith("-") and not re.match(r"^\d*[<>]", arg):
            positional.append(arg)
    if not positional:
        return ["Search"]
    pattern = _short(positional[0], 32)
    targets = [_target_name(arg) for arg in positional[1:] if arg != "-"]
    detail = f"{pattern} in {', '.join(targets[:2])}" if targets else pattern
    return [f"Search({_short(detail)})"]


def _git_label(tokens: list[str]) -> str:
    args = _plain_args(tokens[1:])
    if not args:
        return "Git"
    sub = args[0]
    if sub == "worktree":
        action = args[1] if len(args) > 1 else ""
        target = _target_name(args[2]) if len(args) > 2 and action == "add" else ""
        detail = " ".join(part for part in ("worktree", action, target) if part)
    elif sub in ("add", "branch", "checkout", "diff", "restore", "show", "switch"):
        target = _target_name(args[1]) if len(args) > 1 else ""
        detail = " ".join(part for part in (sub, target) if part)
    else:
        detail = sub
    return f"Git({_short(detail)})"


def _run_label(exe: str, tokens: list[str], segment: str) -> str:
    args = tokens[1:]
    if exe in ("python", "python3", "ruby") and any(arg in args for arg in ("-c", "-e")):
        inline_flag = "-c" if "-c" in args else "-e"
        inline_index = args.index(inline_flag)
        trailing_args = args[inline_index + 2:]
        paths = re.findall(r"(?:open|read_text)\(\s*['\"]([^'\"]+)", segment)
        paths += [arg for arg in trailing_args
                  if "/" in arg or re.search(r"\.[A-Za-z0-9]{1,8}$", arg)]
        target = _target_name(paths[-1]) if paths else "inline"
        if "compile(" in segment or "py_compile" in segment:
            return f"SyntaxCheck({_short(target)})"
        if "assert " in segment or "assert(" in segment:
            return f"Test({_short(target)})"
        if "YAML" in segment or "frontmatter" in segment:
            return f"Validate({_short(target)})"
        return f"Run({_short(exe + ' ' + target)})"

    plain = _plain_args(args)
    if exe in ("python", "python3", "node", "ruby") and plain:
        return f"Run({_short(_target_name(plain[0]))})"
    if exe in ("python", "python3", "ruby"):
        return f"Run({exe} inline)"
    if exe in ("pytest", "swift", "cargo", "make", "npm", "npx"):
        detail = " ".join([exe] + plain[:2])
        return f"Run({_short(detail)})"
    if tokens[0].startswith(("./", "/")):
        return f"Run({_short(_target_name(tokens[0]))})"
    return f"Shell({_short(exe)})"


def _shell_segment_labels(segment: str) -> list[str]:
    tokens = _shell_tokens(segment)
    while tokens and ("=" in tokens[0] and not tokens[0].startswith(("./", "/"))):
        tokens.pop(0)
    while tokens and os.path.basename(tokens[0]) in ("command", "env", "sudo"):
        tokens.pop(0)
    if not tokens:
        return []
    exe = os.path.basename(tokens[0])
    if exe in _SHELL_SKIP or exe.startswith(("$", "-")):
        return []
    if exe in ("cat", "file", "head", "sed", "tail", "wc"):
        return _read_labels(exe, tokens)
    if exe in ("grep", "rg"):
        return _search_labels(exe, tokens)
    if exe in ("find", "fd"):
        args = _plain_args(tokens[1:])
        return [f"Find({_short(_target_name(args[0]))})"] if args else ["Find"]
    if exe == "ls":
        args = _plain_args(tokens[1:])
        target = _target_name(args[-1]) if args else "cwd"
        return [f"List({_short(target)})"]
    if exe == "git":
        return [_git_label(tokens)]
    if exe in ("python", "python3", "node", "ruby", "pytest", "swift", "cargo",
               "make", "npm", "npx") or tokens[0].startswith(("./", "/")):
        return [_run_label(exe, tokens, segment)]
    if exe == "jq":
        targets = [arg for arg in tokens[1:] if re.search(r"\.(?:json|jsonl)$", arg)
                   or (arg.startswith(("/", "$")) and not re.search(r"[\s|(){}]", arg))]
        target = _target_name(targets[-1]) if targets else "JSON"
        return [f"Inspect({_short(target)})"]
    if exe == "which":
        args = _plain_args(tokens[1:])
        return [f"Locate({_short(', '.join(args[:3]))})"] if args else []
    if exe == "codex":
        args = _plain_args(tokens[1:])
        return [f"Codex({_short(' '.join(args[:3]) or 'run')})"]
    if exe in ("cmp", "diff"):
        args = _plain_args(tokens[1:])
        if len(args) >= 2:
            detail = f"{_target_name(args[-2])} ↔ {_target_name(args[-1])}"
            return [f"Compare({_short(detail)})"]
    if exe in ("cp", "mv"):
        args = _plain_args(tokens[1:])
        if len(args) >= 2:
            verb = "Copy" if exe == "cp" else "Move"
            return [f"{verb}({_short(_target_name(args[0]) + ' → ' + _target_name(args[1]))})"]
    if exe in ("mkdir", "touch"):
        return [f"Write({_short(_target_name(arg))})" for arg in _plain_args(tokens[1:])]
    if exe == "rm":
        return [f"Delete({_short(_target_name(arg))})" for arg in _plain_args(tokens[1:])]
    if exe in ("curl", "wget"):
        urls = [arg for arg in tokens[1:] if arg.startswith(("http://", "https://"))]
        return [f"WebFetch({_short(url.split('://', 1)[-1])})" for url in urls]
    targets = [arg for arg in tokens[1:] if not re.search(r"[\s|(){}]", arg)
               and (arg.startswith(("/", "$"))
                    or re.search(r"\.[A-Za-z0-9]{1,8}$", arg))]
    return [f"Shell({exe} → {_short(_target_name(targets[-1]))})"] if targets else []


def _shell_labels(command: str) -> list[str]:
    heredoc = re.search(r"<<-?\s*['\"]?([A-Za-z_][A-Za-z0-9_]*)", command)
    if heredoc:
        header = command.splitlines()[0]
        tokens = _shell_tokens(header)
        exe = os.path.basename(tokens[0]) if tokens else "shell"
        if "assert " in command or "assert(" in command:
            return ["Test(inline)"]
        return [f"Run({_short(exe + ' inline')})"]
    labels = []
    for segment in _shell_segments(command):
        labels.extend(_shell_segment_labels(segment))
    return list(dict.fromkeys(labels))


def _js_code_mask(source: str) -> str:
    """Mask JavaScript string/comment contents while preserving source offsets."""
    masked = list(source)
    state = None
    escaped = False
    i = 0
    while i < len(source):
        ch = source[i]
        nxt = source[i + 1] if i + 1 < len(source) else ""
        if state in ("'", '"', "`"):
            if escaped:
                masked[i] = " "
                escaped = False
            elif ch == "\\":
                masked[i] = " "
                escaped = True
            elif ch == state:
                state = None  # keep the closing quote
            else:
                masked[i] = "\n" if ch == "\n" else " "
        elif state == "line-comment":
            if ch == "\n":
                state = None
            else:
                masked[i] = " "
        elif state == "block-comment":
            masked[i] = "\n" if ch == "\n" else " "
            if ch == "*" and nxt == "/":
                masked[i + 1] = " "
                state = None
                i += 1
        elif ch in ("'", '"', "`"):
            state = ch  # keep delimiters so values can be decoded from the source
        elif ch == "/" and nxt == "/":
            masked[i] = masked[i + 1] = " "
            state = "line-comment"
            i += 1
        elif ch == "/" and nxt == "*":
            masked[i] = masked[i + 1] = " "
            state = "block-comment"
            i += 1
        i += 1
    return "".join(masked)


def _js_string_bindings(source: str) -> dict[str, str]:
    bindings = {}
    decoder = json.JSONDecoder()
    pattern = re.compile(r"\b(?:const|let|var)\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*")
    for match in pattern.finditer(_js_code_mask(source)):
        tail = source[match.end():].lstrip()
        if not tail.startswith('"'):
            continue
        try:
            value, _ = decoder.raw_decode(tail)
        except json.JSONDecodeError:
            continue
        if isinstance(value, str):
            bindings[match.group(1)] = value
    return bindings


def _js_property_strings(source: str, key: str) -> list[str]:
    values = []
    decoder = json.JSONDecoder()
    masked = _js_code_mask(source)
    for match in re.finditer(rf"\b{re.escape(key)}\s*:\s*", masked):
        tail = source[match.end():].lstrip()
        if not tail.startswith('"'):
            continue
        try:
            value, _ = decoder.raw_decode(tail)
        except json.JSONDecodeError:
            continue
        if isinstance(value, str):
            values.append(value)
    return values


def _codex_function_labels(name: str, args: dict) -> list[str]:
    if name in _CODEX_CONTROL_TOOLS:
        return []
    if name in ("exec_command", "shell_command"):
        command = args.get("cmd") or args.get("command")
        return _shell_labels(command) if isinstance(command, str) else [name]
    return [tool_label(name, args)]


def _nested_exec_labels(source: str) -> list[str]:
    """Extract nested tool names (and JSON arguments when available) from exec JS."""
    labels = []
    decoder = json.JSONDecoder()
    bindings = _js_string_bindings(source)
    masked = _js_code_mask(source)
    for match in re.finditer(r"\btools\.([A-Za-z_][A-Za-z0-9_]*)\s*\(", masked):
        name, tail = match.group(1), source[match.end():].lstrip()
        args = {}
        raw = None
        if tail.startswith("{"):
            try:
                parsed, _ = decoder.raw_decode(tail)
                if isinstance(parsed, dict):
                    args = parsed
            except json.JSONDecodeError:
                pass
        elif tail.startswith('"'):
            try:
                raw, _ = decoder.raw_decode(tail)
            except json.JSONDecodeError:
                pass
        else:
            identifier = re.match(r"([A-Za-z_][A-Za-z0-9_]*)", tail)
            if identifier:
                raw = bindings.get(identifier.group(1))

        if name == "apply_patch" and isinstance(raw, str):
            labels.extend(_patch_labels(raw) or ["apply_patch"])
        elif name == "web__run" and not args:
            queries = _js_property_strings(tail[:8000], "q")
            refs = _js_property_strings(tail[:8000], "ref_id")
            labels.extend(f"WebSearch({_short(query)})" for query in queries[:4])
            labels.extend(f"WebOpen({_short(ref)})" for ref in refs[:4])
            if not queries and not refs:
                labels.append("web__run")
        else:
            labels.extend(_codex_function_labels(name, args))
    return list(dict.fromkeys(labels))


def codex_tool_labels(payload: dict) -> list[str]:
    """Return compact labels for a Codex response_item tool call."""
    typ = payload.get("type")
    if typ == "function_call":
        return _codex_function_labels(
            payload.get("name", "tool"), _json_object(payload.get("arguments")))
    if typ == "custom_tool_call":
        name, raw = payload.get("name", "tool"), payload.get("input")
        if name == "apply_patch" and isinstance(raw, str):
            return _patch_labels(raw) or [name]
        if name == "exec" and isinstance(raw, str):
            return _nested_exec_labels(raw)
        return [name]
    if typ == "web_search_call":
        action = payload.get("action")
        if not isinstance(action, dict):
            return ["web_search"]
        action_type = action.get("type")
        if action_type == "search":
            query = action.get("query") or action.get("queries")
            return [tool_label("WebSearch", {"query": query})]
        if action_type == "open_page":
            return [tool_label("WebOpen", {"url": action.get("url")})]
        if action_type == "find_in_page":
            return [tool_label("WebFind", {"pattern": action.get("pattern")})]
        return ["web_search"]
    if typ == "tool_search_call":
        return ["tool_search"]
    return []


def assistant_parts(msg: dict) -> tuple[list[str], list[str], list[str]]:
    """Return (text_blocks, tool_labels, plans) from an assistant message.

    Plan-mode plans exist only inside the ExitPlanMode tool_use input — no
    text block carries them — so they'd vanish behind a bare tool label.
    """
    texts, tools, plans = [], [], []
    content = msg.get("content")
    if isinstance(content, str):
        if content.strip():
            texts.append(content.strip())
    elif isinstance(content, list):
        for b in content:
            if not isinstance(b, dict):
                continue
            t = b.get("type")
            if t == "text" and b.get("text", "").strip():
                texts.append(b["text"].strip())
            elif t == "tool_use":
                plan = (b.get("input") or {}).get("plan") \
                    if b.get("name") == "ExitPlanMode" else None
                if isinstance(plan, str) and plan.strip():
                    plans.append(plan.strip())
                else:
                    tools.append(tool_label(b.get("name", "tool"), b.get("input")))
    return texts, tools, plans


# Codex plan mode delivers the plan as one assistant message wrapped in these
# tags (the item_completed Plan event repeats it, but only in newer rollouts).
_PROPOSED_PLAN_RE = re.compile(r"\A<proposed_plan>\s*(.*?)\s*</proposed_plan>\Z",
                               re.DOTALL)


def _codex_plan_text(text: str) -> str | None:
    m = _PROPOSED_PLAN_RE.match(text.strip())
    return m.group(1) if m else None


def _codex_text_items(payload: dict) -> list[str] | None:
    content = payload.get("content")
    if not isinstance(content, list):
        return None
    return [item["text"] for item in content
            if isinstance(item, dict)
            and item.get("type") in ("input_text", "output_text", "text")
            and isinstance(item.get("text"), str)]


def _codex_message_text(payload: dict) -> str | None:
    parts = _codex_text_items(payload)
    text = "\n".join(parts or []).strip()
    return text or None


# Codex files a lot as user messages that nobody typed: the AGENTS.md it
# loaded, environment and skill context, subagent notices, plugin hints. Newer
# rollouts carry no `user_message` events to tell the typed turns apart, so
# these are cut out of each content item, keeping whatever was typed beside them.
# Each is matched in the exact shape Codex writes it, so the same words typed
# or pasted by the user (mid-sentence, unclosed, a draft AGENTS.md) are kept.
_CODEX_AGENTS_MD_RE = re.compile(
    r"\A\s*# AGENTS\.md instructions\b[^\n]*\n\s*<INSTRUCTIONS>.*?</INSTRUCTIONS>",
    re.DOTALL)
_CODEX_INJECTED_TAGS = (
    "environment_context", "skill", "subagent_notification", "recommended_plugins",
    "turn_aborted", "user_instructions", "realtime_delegation",
    "guardian_tool_descriptions", "external_codex_apps_open_page",
    "in-app-browser-context",
)
_TAG_NAMES = "|".join(map(re.escape, _CODEX_INJECTED_TAGS))
# A whole block: opening tag at the start of a line, closing tag ending one.
_CODEX_INJECTED_RE = re.compile(
    rf"^[ \t]*<({_TAG_NAMES})(?:\s[^>\n]*)?>.*?</\1>[ \t]*(?=\n|\Z)",
    re.DOTALL | re.MULTILINE)
# IDE and attachment context wrapped around the request ("## My request:"),
# or just that header left once an injected block before it is cut.
_CODEX_REQUEST_RE = re.compile(
    r"\A\s*(?:# (?:Context from my IDE setup|Files mentioned by the user|"
    r"Files pasted by the user):.*?^)?## My request(?: for Codex)?:[ \t]*\n?",
    re.DOTALL | re.MULTILINE)
# The user's own `!command`: keep the command, drop its output.
_CODEX_SHELL_RE = re.compile(
    r"\A\s*<user_shell_command>\s*<command>\s*(.*?)\s*</command>", re.DOTALL)
_CODEX_SHELL_END = "</user_shell_command>"
# An answer to a question the agent asked (request_user_input_async).
_CODEX_REPLY_RE = re.compile(
    r"\A\s*<send_user_message_question_reply>\s*(.*?)\s*"
    r"</send_user_message_question_reply>\s*\Z", re.DOTALL)
# Codex Desktop files a typed `$skill` or `@plugin` mention as a link to its
# SKILL.md, or a plugin:// / app:// address; any other link stays a link.
_SKILL_LINK_RE = re.compile(
    r"\[([$@][\w.:-]+)\]\((?:[^)\n]*SKILL\.md|(?:plugin|app)://[^)\n]*)\)")
# An attached image: `<image name=[Image #1] path="…">`, then `</image>`.
_CODEX_IMAGE_RE = re.compile(r"<image name=(\[[^\]\n]*\])[^>\n]*>|</image>")


def _plain_mentions(text: str) -> str:
    """`[$resume-lite](/…/SKILL.md)` back to the `$resume-lite` that was typed."""
    return _SKILL_LINK_RE.sub(r"\1", text)


def _question_answers(raw: str) -> str:
    try:
        replies = json.loads(raw)
    except ValueError:
        return raw
    replies = replies if isinstance(replies, list) else [replies]
    answers = [reply["answer"].strip() for reply in replies
               if isinstance(reply, dict) and isinstance(reply.get("answer"), str)
               and reply["answer"].strip()]
    return "\n".join(answers) or raw


def _codex_typed_item(text: str) -> str:
    """The part of one Codex user content item that the user typed."""
    match = _CODEX_AGENTS_MD_RE.match(text)
    if match:
        text = text[match.end():]
    text = _CODEX_INJECTED_RE.sub("", text)
    match = _CODEX_REQUEST_RE.match(text)
    if match:
        text = text[match.end():]
    match = _CODEX_REPLY_RE.match(text)
    if match:
        text = _question_answers(match.group(1))
    match = _CODEX_SHELL_RE.match(text)
    if match:  # anything typed after the block stays
        end = text.find(_CODEX_SHELL_END, match.end())
        after = text[end + len(_CODEX_SHELL_END):].strip() if end != -1 else ""
        text = "!" + match.group(1) + (f"\n{after}" if after else "")
    text = _CODEX_IMAGE_RE.sub(lambda m: m.group(1) or "", text)
    return _plain_mentions(text).strip()


def _codex_typed_text(payload: dict) -> str | None:
    """A Codex user message minus what the harness injected into it."""
    parts = [_codex_typed_item(text) for text in _codex_text_items(payload) or []]
    text = "\n".join(part for part in parts if part)
    return text or None


# Questions the agent puts to the user live only in these tool calls (no
# assistant message repeats them); the synchronous one's output holds the answer.
_CODEX_QUESTION_TOOLS = frozenset({"request_user_input", "request_user_input_async"})


def _codex_questions(args: dict) -> str | None:
    blocks = []
    for question in args.get("questions") or []:
        if not isinstance(question, dict):
            continue
        text = question.get("question") or question.get("title")
        if not isinstance(text, str) or not text.strip():
            continue
        lines = [text.strip()]
        for option in question.get("options") or []:
            label = option.get("label") if isinstance(option, dict) else option
            if isinstance(label, str) and label.strip():
                lines.append(f"- {label.strip()}")
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks) or None


def _codex_answers(output) -> str | None:
    data = _json_object(output)
    answers = data.get("answers")
    if not isinstance(answers, dict):
        return None
    picked = [answer.strip() for entry in answers.values() if isinstance(entry, dict)
              for answer in entry.get("answers") or []
              if isinstance(answer, str) and answer.strip()]
    return "\n".join(picked) or None


def normalized_events(records: list[dict], provider: str):
    """Yield (user|assistant|plan|tool, text) events from either provider."""
    if provider == "claude":
        for r in records:
            if r.get("isSidechain") or r.get("isMeta") or _harness_origin(r):
                continue
            queued = queued_prompt(r)  # never also filed as a user record
            if queued:
                yield "user", queued
                continue
            typ, msg = r.get("type"), r.get("message")
            if not isinstance(msg, dict):
                continue
            if typ == "user":
                text = user_text(msg)
                if text is not None:
                    yield "user", text
            elif typ == "assistant":
                texts, tools, plans = assistant_parts(msg)
                for label in tools:
                    yield "tool", label
                for text in texts:
                    yield "assistant", text
                for plan in plans:
                    yield "plan", plan
        return

    event_types = {r.get("payload", {}).get("type") for r in records
                   if r.get("type") == "event_msg"
                   and isinstance(r.get("payload"), dict)}
    # Assistant response_items are deduped against agent_message *texts*, not
    # just the event type: plan-mode's final plan has no agent_message twin,
    # and an event-type check would swallow it along with the duplicates.
    agent_texts = {r["payload"]["message"].strip() for r in records
                   if r.get("type") == "event_msg"
                   and isinstance(r.get("payload"), dict)
                   and r["payload"].get("type") == "agent_message"
                   and isinstance(r["payload"].get("message"), str)}
    asked: set = set()  # call ids of questions put to the user
    for r in records:
        payload = r.get("payload")
        if not isinstance(payload, dict):
            continue
        if r.get("type") == "event_msg":
            typ, text = payload.get("type"), payload.get("message")
            if not isinstance(text, str) or not text.strip():
                continue
            if typ == "user_message":
                yield "user", text.strip()
            elif typ == "agent_message":
                plan = _codex_plan_text(text)
                yield ("plan", plan) if plan else ("assistant", text.strip())
        elif r.get("type") == "response_item":
            kind = payload.get("type")
            if kind == "message":
                role = payload.get("role")
                if role == "user" and "user_message" not in event_types:
                    text = _codex_typed_text(payload)
                    if text:
                        yield "user", text
                elif role == "assistant":
                    text = _codex_message_text(payload)
                    if text and text not in agent_texts:
                        plan = _codex_plan_text(text)
                        yield ("plan", plan) if plan else ("assistant", text)
            elif kind == "function_call" and payload.get("name") in _CODEX_QUESTION_TOOLS:
                question = _codex_questions(_json_object(payload.get("arguments")))
                if question:
                    asked.add(payload.get("call_id"))
                    yield "assistant", question
            elif kind == "function_call_output" and payload.get("call_id") in asked:
                answer = _codex_answers(payload.get("output"))  # sync tool only
                if answer:
                    yield "user", answer
            for label in codex_tool_labels(payload):
                yield "tool", label


def _session_cwd(records: list[dict], provider: str) -> str:
    if provider == "claude":
        return next((r.get("cwd") for r in records if r.get("cwd")), "")
    for r in records:
        payload = r.get("payload")
        if r.get("type") in ("session_meta", "turn_context") and isinstance(payload, dict):
            if payload.get("cwd"):
                return payload["cwd"]
    return ""


def canonical_session_id(records: list[dict], path: Path, provider: str) -> str:
    if provider == "codex":
        for r in records:
            payload = r.get("payload")
            if r.get("type") == "session_meta" and isinstance(payload, dict):
                if isinstance(payload.get("id"), str):
                    return payload["id"]
    return path.stem


class Session(NamedTuple):
    """A resolved session: where it lives, what it is, and its records."""
    path: Path
    provider: str
    id: str
    records: list[dict]


def load_session(path: Path, provider: str) -> Session:
    records = load_records(path)
    return Session(path, provider,
                   canonical_session_id(records, path, provider), records)


# A session records where it was resumed from in three shapes: the human's
# `/resume-lite <id>` (Codex: `$resume-lite <id>`), the script invocation the
# skill then runs, and the read of the transcript it produced. So match those
# fields specifically. A blind grep for the skill's name would hit every session
# on disk, since its description sits in every system prompt that lists skills.
_SESSION_ID_RE = re.compile(
    r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", re.I)
# Each pattern captures the region an id can legitimately sit in, so an
# unrelated id elsewhere in the same long prompt or command can't ride along.
_LINEAGE_PATTERNS = (
    # Claude Code files a slash command's arguments in their own block.
    re.compile(r"<command-name>\s*/resume-lite\s*</command-name>\s*"
               r"<command-args>([^<]*)</command-args>"),
    # Typed plainly (Codex `$resume-lite <id>`). Require a standalone command,
    # not the name inside /path/to/resume-lite/SKILL.md, and stop at the next
    # shell command just as we do for the script invocation below.
    re.compile(r"(?<![\w/.$-])[/$]resume-lite(?=[ \t]|$)([^\n|;&]*)"),
    # The invocation the skill runs: ids are arguments of that one command.
    re.compile(r"(?<![\w-])session-transcript[\"']?[ \t]+([^\n|;&]*)"),
    # And the read of what it produced.
    re.compile(r"session-transcript/([0-9a-fA-F-]{36})/"),
)
_ARGUMENT_PATTERNS = (_LINEAGE_PATTERNS[0], _LINEAGE_PATTERNS[2])
# A full id, or the 8+ character start of one (`session-transcript 665adf03`).
_SHORT_ID_RE = re.compile(r"(?<![\w./-])[0-9a-f]{8}(?:-[0-9a-f-]{1,27})?(?![\w./-])",
                          re.I)
# Invocations that aren't a resume name no parent: one that writes the
# transcript somewhere chosen to keep it (/export-lite runs --save, --out or
# --to) archives a session rather than continuing it, and a --recent recap
# names only the sessions it --excludes. Matched after quotes and backslashes
# are blanked out, so `"--save"` and a JS-escaped `\"--save\"` count; argparse
# abbreviations are off, so `--sa` can't sneak by.
_EXPORT_FLAG_RE = re.compile(r"(?<!\S)--(?:save|out|to|recent)(?=[\s=]|$)")
_QUOTES_RE = re.compile(r"[\"'\\]")
# A shell line continuation keeps one command going onto the next line.
_CONTINUATION_RE = re.compile(r"\\\r?\n")
# Prose fields of a tool call (Claude's Bash `description`, Codex's
# `justification`, a message or task prompt to another agent): they can name a
# session, or quote a command, without running anything.
_PROSE_KEYS = frozenset({"description", "justification", "message", "prompt"})


def _string_values(value):
    """Strings in a structured tool input, without JSON escaping or siblings."""
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from _string_values(item)
    elif isinstance(value, list):
        for item in value:
            yield from _string_values(item)


def _tool_input_strings(value):
    """A tool input's strings, minus the prose fields describing the call."""
    if isinstance(value, dict):
        value = {k: v for k, v in value.items() if k not in _PROSE_KEYS}
    yield from _string_values(value)


def _lineage_strings(record: dict, provider: str):
    """Fields of one record that could name a session it was resumed from.

    User prompts and tool *inputs* only: assistant prose merely discussing a
    session isn't a resume, and tool outputs replay ids from the transcripts
    they just read.
    """
    if provider == "claude":
        queued = queued_prompt(record)
        if queued:
            yield queued
        message = record.get("message")
        if not isinstance(message, dict) or _harness_origin(record):
            return  # a task notice can quote a subagent's own commands
        content = message.get("content")
        if record.get("type") == "user":
            if isinstance(content, str):
                yield content
            elif isinstance(content, list):
                for block in content:  # text blocks only: a tool_result keeps
                    if isinstance(block, dict) \
                            and isinstance(block.get("text"), str):
                        yield block["text"]  # its payload under "content"
        elif record.get("type") == "assistant" and isinstance(content, list):
            for block in content:
                if not isinstance(block, dict) or block.get("type") != "tool_use":
                    continue
                yield from _tool_input_strings(block.get("input"))
        return

    payload = record.get("payload")
    if not isinstance(payload, dict):
        return
    # user_message, not agent_message: the assistant merely discussing a
    # session is not a resume.
    if payload.get("type") == "user_message" and isinstance(payload.get("message"), str):
        yield _plain_mentions(payload["message"])  # Codex's [$skill](…) mentions
    if payload.get("type") == "message" and payload.get("role") == "user":
        text = _codex_typed_text(payload)  # not what the harness injected
        if text:
            yield text
    for key in ("input", "arguments", "command"):  # custom_tool_call / function_call
        value = payload.get(key)
        if isinstance(value, str):
            # Function-call arguments are JSON: parse before matching so a
            # command's escaped newline ends its arguments, and unrelated
            # input fields cannot supply an extra parent id.
            if key == "arguments":
                try:
                    value = json.loads(value)
                except json.JSONDecodeError:
                    pass
            # A code-mode `exec` input is JS source whose commands sit in string
            # literals with their newlines still escaped; unescape them so each
            # command ends at its own line, as in a plain shell call.
            elif key == "input":
                value = value.replace("\\n", "\n")
            yield from _tool_input_strings(value)


def lineage_ids(session: Session) -> list[str]:
    """Session ids this session was resumed from, in the order they appear."""
    found: list[str] = []
    for record in session.records:
        for text in _lineage_strings(record, session.provider):
            text = _CONTINUATION_RE.sub(" ", text)
            for pattern in _LINEAGE_PATTERNS:
                for match in pattern.finditer(text):
                    if _EXPORT_FLAG_RE.search(_QUOTES_RE.sub(" ", match.group(1))):
                        continue
                    # An argument list can name a session by its short id
                    # too; free typed text only by a full one (an 8-hex
                    # commit hash there is no session).
                    ids = (_SHORT_ID_RE if pattern in _ARGUMENT_PATTERNS
                           else _SESSION_ID_RE).findall(match.group(1))
                    for sid in ids:
                        sid = sid.lower()
                        if not session.id.lower().startswith(sid) and sid not in found:
                            found.append(sid)
    return found


def follow_lineage(seeds: list[Session]) -> tuple[list[Session], dict[str, list[str]]]:
    """Pull in the sessions the seeds were resumed from, transitively.

    Discovery runs backwards (you hold the newest chat and learn its parent by
    reading it) but that never reaches the caller: the walk only collects a
    set — a visited set keeps a chain that loops, or two chats resumed from one
    parent, from spinning — and the caller then sorts it into reading order.
    """
    sessions = list(seeds)
    by_path = {s.path.resolve(): s for s in sessions}
    parents: dict[str, list[str]] = {}
    queue = list(sessions)
    while queue:
        session = queue.pop(0)
        for sid in lineage_ids(session):
            hits = resolve_reference(sid)  # a short id, by the same rules
            if len(hits) != 1:
                reason = "ambiguous" if hits else "not found"
                print(f"--deep: {session.id[:8]} references {sid[:8]} "
                      f"({reason}, skipped)", file=sys.stderr)
                continue
            key = hits[0][0].resolve()
            parent = by_path.get(key)
            if parent is None:
                parent = load_session(*hits[0])
                by_path[key] = parent
                sessions.append(parent)
                queue.append(parent)
            if parent.id == session.id:
                continue
            print(f"--deep: {session.id[:8]} resumed from {parent.id[:8]}",
                  file=sys.stderr)
            if parent.id not in parents.setdefault(session.id, []):
                parents[session.id].append(parent.id)
    return sessions, parents


def session_start(session: Session) -> datetime.datetime:
    """When the session began — the sort key that puts a chain in order."""
    stamps = _timestamps(session.records)
    if stamps:
        try:
            started = datetime.datetime.fromisoformat(stamps[0].replace("Z", "+00:00"))
            return started if started.tzinfo else started.replace(
                tzinfo=datetime.timezone.utc)
        except ValueError:
            pass
    return datetime.datetime.fromtimestamp(session.path.stat().st_mtime,
                                           datetime.timezone.utc)


def _compact_tool_labels(labels: list[str]) -> list[str]:
    """Deduplicate tool labels and cap repetitive categories without losing edits."""
    unique = list(dict.fromkeys(labels))
    caps = {"Read": 6, "Run": 4, "Search": 4, "WebOpen": 3, "WebSearch": 3}
    totals: dict[str, int] = {}
    for label in unique:
        kind = label.split("(", 1)[0]
        totals[kind] = totals.get(kind, 0) + 1

    compact, seen = [], {}
    for label in unique:
        kind = label.split("(", 1)[0]
        count = seen.get(kind, 0)
        cap = caps.get(kind)
        if cap is None or count < cap:
            compact.append(label)
        elif count == cap:
            compact.append(f"{kind}(+{totals[kind] - cap} more)")
        seen[kind] = count + 1
    return compact


# A kept export (--save/--out/--to) gets only the neutral first sentence: an
# instruction to continue the work would be baked into a committed file.
EXPORT_BLURB = ("> Light transcript (human ↔ assistant text and plan-mode plans; each "
                "tool call noted with its target when available — tool *outputs* and "
                "thinking omitted).")
# --no-tools says so, which also tells a kept file's mode apart (see
# transcript_signature).
NO_TOOLS_MARK = "plan-mode plans only — tool calls"
EXPORT_BLURB_NO_TOOLS = (f"> Light transcript (human ↔ assistant text and {NO_TOOLS_MARK}, "
                         "their outputs and thinking omitted).")
RESUME_LINE = " Read it to recover where we left off, then continue the work."
BLURB = EXPORT_BLURB + RESUME_LINE


def _source_name(provider: str) -> str:
    return "Claude Code" if provider == "claude" else "Codex"


def _turns(count: int) -> str:
    return f"{count} user turn" + ("" if count == 1 else "s")


def _timestamps(records: list[dict]) -> list[str]:
    return [r.get("timestamp") for r in records if r.get("timestamp")]


def _span(timestamps: list[str]) -> str:
    return f"{timestamps[0]} → {timestamps[-1]}" if timestamps else ""


def _plural(count: int, noun: str) -> str:
    return f"{count} {noun}" + ("" if count == 1 else "s")


def _elision(omitted: int, keep: int, total: int) -> list[str]:
    return [f"## ✂️ {_plural(omitted, 'message')} omitted\n",
            f"_--messages {keep}: showing the first {keep} and last {keep} of "
            f"this session's {total} messages._\n"]


def _transcript_body(records: list[dict], show_tools: bool, provider: str,
                     messages: int | None = None) -> tuple[str, int]:
    """Render the turns of one session; returns (markdown, user-turn count).

    A message is one user prompt (`## 👤 User`), or the assistant's whole reply
    to it: every `## 🤖 <assistant>` and `## 📋 Plan` block up to the next
    prompt, with their `🔧 tools:` lines — including tools run before the
    first text, and a reply of nothing but tools. A reply often runs to a dozen blocks,
    so counting blocks would let the cut swallow the user's last ask. With
    `messages`, only the first and last that many are kept, with a marker for
    the cut.
    """
    groups: list[tuple[str, list[str]]] = []  # (user|assistant, its lines)
    lead: list[str] = []  # a tool trace from before the first message
    exchanges = 0
    pending_tools: list[str] = []

    def flush_tools():
        if show_tools and pending_tools:
            compact = ", ".join(_compact_tool_labels(pending_tools))
            line = f"_🔧 tools: {compact}_\n"
            if not groups:
                lead.append(line)
            else:
                # Tools run right after a prompt open the reply to it (which
                # may be nothing but tools), rather than tail the prompt.
                if groups[-1][0] == "user":
                    groups.append(("assistant", []))
                groups[-1][1].append(line)
        pending_tools.clear()

    def add(side: str, line: str):
        flush_tools()
        if side == "user" or not groups or groups[-1][0] == "user":
            groups.append((side, []))
        groups[-1][1].append(line)

    assistant_name = "Claude" if provider == "claude" else "Codex"
    for typ, value in normalized_events(records, provider):
        if typ == "user":
            exchanges += 1
            add("user", f"## 👤 User\n\n{value}\n")
        elif typ == "assistant":
            add("assistant", f"## 🤖 {assistant_name}\n\n{value}\n")
        elif typ == "plan":
            add("assistant", f"## 📋 Plan ({assistant_name})\n\n{value}\n")
        elif typ == "tool":
            pending_tools.append(value)
    flush_tools()
    blocks = [lines for _, lines in groups]
    if messages and len(blocks) > 2 * messages:
        omitted = len(blocks) - 2 * messages
        blocks = (blocks[:messages] + [_elision(omitted, messages, len(blocks))]
                  + blocks[-messages:])
    lines = lead + [line for block in blocks for line in block]
    return "\n".join(lines), exchanges


def _meta_line(records: list[dict], provider: str, exchanges: int) -> str:
    cwd = _session_cwd(records, provider)
    return (f"_Source: {_source_name(provider)} · Project: `{cwd}` · "
            f"{_turns(exchanges)} · {_span(_timestamps(records))}_")


def build_transcript(records: list[dict], session_id: str, show_tools: bool,
                     provider: str, blurb: str = BLURB,
                     messages: int | None = None) -> str:
    body, exchanges = _transcript_body(records, show_tools, provider, messages)
    header = [
        f"# Session transcript — `{session_id}`",
        "",
        _meta_line(records, provider, exchanges),
        "",
        blurb,
        "",
        "---",
        "",
    ]
    return "\n".join(header) + body


def build_combined(sessions: list[Session], show_tools: bool,
                   lineage: dict[str, list[str]] | None = None,
                   blurb: str = BLURB, messages: int | None = None,
                   title: str | None = None, last_active: bool = False) -> str:
    """Stitch several sessions into one document, in the order given to it.

    Several ids are usually one conversation continued across sessions, so the
    reader wants a single file to page through rather than N of them: a shared
    header and index up front, then each session under its own `#` heading with
    the turn headings (`##`) unchanged.
    """
    parts = []
    for session in sessions:
        body, exchanges = _transcript_body(session.records, show_tools,
                                           session.provider, messages)
        parts.append({
            "id": session.id,
            "provider": session.provider,
            "cwd": _session_cwd(session.records, session.provider),
            "stamps": _timestamps(session.records),
            "turns": exchanges,
            "body": body,
            # A recap names each session's day: say it in local time, as the
            # listing does (the records' own stamps are UTC).
            "active": f" · last active {_local_time(last_activity(session.path))}"
                      if last_active else "",
        })

    total = len(parts)
    cwd = next((p["cwd"] for p in parts if p["cwd"]), "")
    turns = sum(p["turns"] for p in parts)
    # Overall span from every timestamp, since the ids may be given newest-first.
    stamps = sorted(s for p in parts for s in p["stamps"])
    span = _span([stamps[0], stamps[-1]]) if stamps else ""
    sources = ", ".join(dict.fromkeys(_source_name(p["provider"]) for p in parts))

    out = [
        f"# Session transcript — {title or f'{total} sessions combined'}",
        "",
        f"_Source: {sources} · Project: `{cwd}` · {_turns(turns)} "
        f"across {_plural(total, 'session')} · {span}_",
        "",
        blurb,
        "",
        "Sessions in this file:",
        "",
    ]
    # Say why each session is here, so a chain pulled in by --deep is legible
    # (and a wrong turn in the walk is obvious) rather than just a longer file.
    position = {p["id"]: i for i, p in enumerate(parts, 1)}
    for i, p in enumerate(parts, 1):
        origins = [f"#{position[pid]}" for pid in (lineage or {}).get(p["id"], [])
                   if pid in position]
        resumed = f" · resumed from {', '.join(origins)}" if origins else ""
        out.append(f"{i}. `{p['id']}` — {_source_name(p['provider'])} · "
                   f"{_turns(p['turns'])} · {_span(p['stamps'])}{p['active']}{resumed}")
    out.append("")

    for i, p in enumerate(parts, 1):
        out += [
            "---",
            "",
            f"# Session {i} of {total} — `{p['id']}`",
            "",
            f"_Source: {_source_name(p['provider'])} · Project: `{p['cwd']}` · "
            f"{_turns(p['turns'])} · {_span(p['stamps'])}{p['active']}_",
            "",
            p["body"],
        ]
    return "\n".join(out)


def _session_ids_hash(session_ids: list[str]) -> str:
    """Stable identity for all full ids, including their transcript order."""
    encoded = json.dumps(session_ids, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()[:16]


def combined_out_path(session_ids: list[str], kind: str = "combined",
                      suffix: str = "") -> Path:
    """Default path for a stitched transcript: named after the ids it holds.

    A --recent recap lives under `recent-<ids>-<hash>/recent.md`; the prefix
    keeps it out of resume's `<ids>-<hash>/` (all hex) and `<uuid>/` dirs.
    """
    shorts = [sid[:8] for sid in session_ids]
    name = "+".join(shorts[:4])
    if len(shorts) > 4:
        name += f"+{len(shorts) - 4}more"
    if kind != "combined":
        name = f"{kind}-{name}"
    return (OUT_ROOT / f"{name}-{_session_ids_hash(session_ids)}"
            / f"{kind}{suffix}.md")


# Letters NFKD doesn't take apart into a base letter plus accents.
_TRANSLITERATE = str.maketrans({
    "đ": "d", "Đ": "d", "ð": "d", "Ð": "d", "ø": "o", "Ø": "o", "ł": "l", "Ł": "l",
    "ß": "ss", "æ": "ae", "Æ": "ae", "œ": "oe", "Œ": "oe", "þ": "th", "Þ": "th",
    "ı": "i", "ħ": "h", "Ħ": "h",
})


def _slugify(text: str, limit: int = 48) -> str:
    """Lowercase ASCII words joined by hyphens: `Čišćenje Đura` -> `ciscenje-dura`."""
    plain = unicodedata.normalize("NFKD", text.translate(_TRANSLITERATE))
    plain = "".join(ch for ch in plain if not unicodedata.combining(ch))
    slug = re.sub(r"[^a-z0-9]+", "-", plain.lower()).strip("-")
    if len(slug) <= limit:
        return slug
    return slug[:limit].rsplit("-", 1)[0] or slug[:limit]  # don't end mid-word


def save_out_path(sessions: list[Session], directory: Path | str = SAVE_DIR,
                  topic: str | None = None) -> Path:
    """In-project path for a transcript worth keeping (and committing).

    Named for a human scanning a repo listing, not for a machine: the date the
    work last moved (the latest activity across the sessions) and the opening
    prompt of the first session are what you recognize it by months later —
    or the topic the user gave, which names it better. Two exports can share
    a name; claim_name settles it.
    """
    session = sessions[0]
    latest = max(last_activity(s.path) for s in sessions)
    date = (datetime.date.fromtimestamp(latest) if latest != float("-inf")
            else datetime.date.today()).isoformat()
    slug = _slugify(topic or "")
    if topic and not slug:
        print(f"--topic {topic!r}: no letters or digits a file name can keep; "
              "naming it after the opening prompt instead", file=sys.stderr)
    if not slug:
        opening = first_user_snippet(session.path, session.provider, limit=120,
                                     skip_commands=True)
        slug = _slugify(_SESSION_ID_RE.sub(" ", opening)) or "session"
    return Path(directory) / f"{date}-{slug}.md"


_TITLE = "# Session transcript — "


def transcript_signature(lines) -> tuple | None:
    """What a transcript of ours holds, read from its header (the lines up to
    the first `---`): (single|combined|recap, its session ids in order, the
    --messages count or None, tools|no-tools). None for any other file."""
    header = []
    for line in lines:
        if line.rstrip("\n") == "---":
            break
        header.append(line.rstrip("\n"))
        if len(header) > 5000:  # no header of ours runs this long
            return None
    else:
        return None  # never reached the `---` that ends every header of ours
    if not header or not header[0].startswith(_TITLE) \
            or not any(line.startswith("_Source: ") for line in header):
        return None
    title = header[0][len(_TITLE):]
    text = "\n".join(header)
    trim = re.search(r"^> Trimmed with --messages (\d+):", text, re.MULTILINE)
    messages = int(trim.group(1)) if trim else None
    tools = "no-tools" if NO_TOOLS_MARK in text else "tools"
    single = re.fullmatch(r"`([^`\s]+)`", title)
    if single:
        return "single", (single.group(1),), messages, tools
    ids = tuple(re.findall(r"^\d+\. `([^`\s]+)` — ", text, re.MULTILINE))
    if not ids:
        return None
    if re.fullmatch(r"\d+ most recent (?:Claude Code |Codex )?sessions?", title):
        return "recap", ids, messages, tools
    if re.fullmatch(r"\d+ sessions combined", title):
        return "combined", ids, messages, tools
    return None


def _body(lines: list[str]) -> list[str]:
    """A transcript's lines below its header, minus each session's meta line
    (turn counts, time spans: they change as a session grows). Only that line,
    under a `# Session …` heading, is skipped: one the user wrote stays."""
    end = lines.index("---") if "---" in lines else len(lines)
    body: list[str] = []
    for line in lines[end + 1:]:
        heading = next((kept for kept in reversed(body[-2:]) if kept.strip()), "")
        if line.startswith("_Source: ") and heading.startswith("# Session ") \
                and (body[-1] == heading or not body[-1].strip()):
            continue
        body.append(line)
    while body and not body[-1].strip():
        body.pop()
    return body


def _before_cut(lines: list[str]) -> list[str]:
    """A trimmed transcript up to its first `✂️` marker: the opening messages,
    which stay put while the omitted count and the last ones move on."""
    cut = next((i for i, line in enumerate(lines) if line.startswith("## ✂️")), None)
    return lines if cut is None else lines[:cut]


def replaceable(path: Path, transcript: str) -> bool:
    """Whether writing `transcript` over `path` loses nothing: the file is an
    earlier export of the same thing, and the new one only adds to it. Notes
    the user wrote into it, or another session, make it not."""
    new = transcript.splitlines()
    signature = transcript_signature(new)
    if not path.is_file() or _file_signature(path) != signature:
        return False
    try:
        old = _body(path.read_text(encoding="utf-8").splitlines())
    except (OSError, UnicodeDecodeError):
        return False
    new = _body(new)
    if signature and signature[2] is not None:  # trimmed: compare the openings
        old, new = _before_cut(old), _before_cut(new)
    if old and old[-1].startswith("_🔧 tools: "):
        old.pop()  # a turn still running when it was exported gains more tools
    return new[:len(old)] == old


def _file_signature(path: Path) -> tuple | None:
    try:
        return transcript_signature(_lines(path))
    except (OSError, UnicodeDecodeError):
        return None


def claim_name(path: Path, transcript: str) -> Path:
    """An auto-generated name (date + topic) to write `transcript` to.

    Exporting the same thing again (same session ids, same kind of transcript,
    same --messages and tools mode) overwrites the earlier file, as long as it
    holds nothing the new one doesn't (see replaceable); anything else already
    there, including a file that isn't one of our transcripts, is left alone
    and the name takes the first free `-2`, `-3`, ….
    """
    candidate, number = path, 1
    while os.path.lexists(candidate):  # a dangling link is taken too
        if not candidate.is_symlink() and replaceable(candidate, transcript):
            return candidate  # never written through a link
        number += 1
        candidate = path.with_name(f"{path.stem}-{number}{path.suffix}")
    return candidate


def out_path(target: str, sessions: list[Session], topic: str | None = None,
             transcript: str | None = None) -> Path:
    """--out: a file path is the exact name; a directory gets the --save name
    (settled by claim_name when the transcript to write is given).

    A directory is one that already exists, or a path ending in a separator
    (created on write), so `--out notes/` can't quietly become a file `notes`.
    """
    separators = tuple(sep for sep in (os.sep, os.altsep) if sep)
    path = Path(target).expanduser()
    if target.endswith(separators) and path.exists() and not path.is_dir():
        sys.exit(f"{target}: not a directory")
    if target.endswith(separators) or path.is_dir():
        named = save_out_path(sessions, path, topic)
        return claim_name(named, transcript) if transcript is not None else named
    if topic is not None:
        print(f"--topic {topic!r} ignored: {target} is an exact file name",
              file=sys.stderr)
    if transcript is not None and os.path.lexists(path) \
            and not replaceable(path, transcript):
        what = ("isn't an earlier export of this: another session's, or one with "
                "notes added" if _file_signature(path) else
                "isn't a session transcript")
        sys.exit(f"{target} already exists and {what}: not replacing it (give "
                 "another file name, or a directory/ to get <date>-<topic>.md "
                 "inside it)")
    return path


# `this` names the session the calling agent runs in, read from what each
# harness sets in its shells: Codex's CODEX_THREAD_ID, Claude Code's (so far
# undocumented) CLAUDE_CODE_SESSION_ID. Resolved here, not in the skill's shell
# command, so it works from any shell: in PowerShell "$CODEX_THREAD_ID" is a PS
# variable, always empty.
CURRENT_SESSION = "this"
CURRENT_SESSION_ENV = ("CODEX_THREAD_ID", "CLAUDE_CODE_SESSION_ID")


def _last_written(session_id: str) -> float:
    _, hits = session_hits(session_id)
    stamps = []
    for path, _ in hits:
        try:
            stamps.append(path.stat().st_mtime)
        except OSError:
            pass
    return max(stamps, default=float("-inf"))


_NO_CURRENT = (f"neither {' nor '.join(CURRENT_SESSION_ENV)} is set")


def _find_current_session() -> tuple[str, str] | None:
    """(id, where it came from) of the session running this script, if known."""
    found: dict[str, str] = {}  # id -> the variable it came from
    for name in CURRENT_SESSION_ENV:
        value = os.environ.get(name, "").strip()
        if value and value not in found:
            found[value] = name
    if not found:
        return None
    if len(found) == 1:
        value, name = next(iter(found.items()))
        return value, f"from {name}"
    # Both set and different: one harness runs inside the other (say, Claude
    # Code started from a Codex shell), each env var inherited or set by its
    # own. The inner one is the one writing its session right now, so take
    # whichever session file was modified last.
    value = max(found, key=_last_written)  # tie: first in CURRENT_SESSION_ENV
    others = ", ".join(f"{n}={v}" for v, n in found.items() if v != value)
    return value, f"from {found[value]}, the most recently written; not {others}"


def _is_current(word: str) -> bool:
    return word.strip().lower() == CURRENT_SESSION


def current_session_id() -> str:
    found = _find_current_session()
    if found is None:
        sys.exit(f"can't tell which session is '{CURRENT_SESSION}': {_NO_CURRENT} "
                 "— pass its id instead (run with no ids to list this "
                 "project's sessions)")
    value, note = found
    print(f"{CURRENT_SESSION}: {value} ({note})", file=sys.stderr)
    return value


def resolve_excludes(values: list[str], candidates: list[tuple[Path, str, str]]
                     ) -> tuple[set[str], str | None]:
    """--exclude values as the full (lowercase) ids they name in this project.

    Each is a full id, a unique prefix of one (say the 8-char short id), or
    `this`. One naming no session, or several, is reported on stderr and
    skipped rather than sinking the whole recap. Returns (ids, the current
    session's id when `this` named one here).
    """
    known = list(dict.fromkeys(sid.lower() for _, _, sid in candidates))
    excluded: set[str] = set()
    current = None
    for raw in values:
        value = raw.strip()
        this = _is_current(value)
        if this:
            found = _find_current_session()
            if found is None:
                print(f"--exclude {CURRENT_SESSION}: {_NO_CURRENT}, so nothing "
                      "is excluded for it", file=sys.stderr)
                continue
            value, note = found
            print(f"--exclude {CURRENT_SESSION}: {value} ({note})", file=sys.stderr)
        key = value.lower()
        matches = [sid for sid in known if sid == key] \
            or [sid for sid in known if len(key) >= 4 and sid.startswith(key)]
        if len(matches) != 1:
            why = (f"matches {len(matches)} sessions, give more of the id" if matches
                   else "too short, give at least 4 characters of the id"
                   if len(key) < 4 else "matches no session in this project")
            print(f"--exclude {raw}: {why}; ignored", file=sys.stderr)
            continue
        excluded.add(matches[0])
        if this:
            current = matches[0]
    return excluded, current


def _has_messages(session: Session) -> bool:
    return any(typ in ("user", "assistant", "plan")
               for typ, _ in normalized_events(session.records, session.provider))


# This skill family, typed (`/recap-lite 10`, `$resume-lite <id>`) or as a
# plugin-namespaced slash command (`/plugin:resume-lite`).
_FAMILY_COMMAND_RE = re.compile(r"\A[/$](?:[\w.-]+:)?(?:resume|recap|export)-lite\Z")
# What their arguments look like: ids or prefixes, counts, `this`, flags.
_FAMILY_ARG_RE = re.compile(
    r"\A(?:[0-9a-f-]{8,36}|\d+|this|--?[a-z][\w-]*(?:=\S*)?)\Z", re.I)  # id: 8+
_FAMILY_VALUE_FLAGS = frozenset({"--to", "--out", "--exclude", "--messages",
                                 "--provider", "--recent"})
_COMMAND_ARGS_RE = re.compile(r"<command-args>(.*?)</command-args>", re.DOTALL)


def _family_invocation(text: str) -> bool:
    """Whether a prompt only runs resume/recap/export-lite, with nothing typed
    beyond its arguments (`/resume-lite <id> and fix the bug` is real work)."""
    tokens = text.split()  # Codex mentions arrive here already as plain `$name`
    if not tokens or not _FAMILY_COMMAND_RE.match(tokens[0]):
        return False
    takes_value = False
    for token in tokens[1:]:
        if takes_value:
            takes_value = False
            continue
        token = token.strip("\"'")
        if not _FAMILY_ARG_RE.match(token):
            return False
        takes_value = token.lower() in _FAMILY_VALUE_FLAGS
    return True


def only_ran_this_family(session: Session) -> bool:
    """True when every user input in the session just invoked this family.

    A bare `/resume-lite` that only listed sessions, or an earlier recap, would
    make a recap a summary of summaries. A session where the user went on to
    type anything else, or ran some other command (whose output is real
    content), is kept.
    """
    invoked = False
    if session.provider != "claude":
        for typ, text in normalized_events(session.records, session.provider):
            if typ == "user":
                if not _family_invocation(text):
                    return False
                invoked = True
        return invoked
    for record in session.records:
        queued = queued_prompt(record)  # typed mid-turn: input like any other
        if queued:
            if not _family_invocation(queued):
                return False
            invoked = True
            continue
        message = record.get("message")
        if record.get("type") != "user" or record.get("isSidechain") \
                or record.get("isMeta") or _harness_origin(record) \
                or not isinstance(message, dict):
            continue
        command = _command_name(message)
        if command:  # Claude files a slash command's arguments separately
            args = _COMMAND_ARGS_RE.search(_text_content(message) or "")
            text = f"{command} {args.group(1) if args else ''}"
        else:
            text = user_text(message)
            if text is None:  # tool results, caveats, interrupt markers
                continue
        if not _family_invocation(text):
            return False
        invoked = True
    return invoked


def recent_sessions(candidates: list[tuple[Path, str, str]], count: int,
                    provider: str | None = None, exclude: set[str] = frozenset()
                    ) -> tuple[list[Session], list[str], int]:
    """This project's `count` most recent sessions, newest first.

    `candidates` comes from list_sessions, already newest first by last
    activity. Passed over: excluded ids, sessions with no conversation at all, and
    sessions that only ran this skill family (see only_ran_this_family).
    Returns (sessions, excluded ids passed over on the way, family-only
    sessions passed over), counting only what came before the last pick.
    """
    picked: list[Session] = []
    excluded: list[str] = []
    summaries = 0
    for path, session_provider, sid in candidates:
        if provider and session_provider != provider:
            continue
        if sid.lower() in exclude:
            excluded.append(sid.lower())
            continue
        session = load_session(path, session_provider)
        if not _has_messages(session):
            continue
        if only_ran_this_family(session):
            summaries += 1
            continue
        picked.append(session)
        if len(picked) == count:
            break
    return picked, excluded, summaries


def print_session_list() -> None:
    """No session id given: list this project's sessions so one can be chosen."""
    cwd = os.getcwd()  # sessions are scoped to this directory; name it so a
    sessions = list_sessions()  # wrong CWD is obvious rather than "none exist"
    if not sessions:
        print(f"No Claude Code or Codex sessions found for {cwd}")
        return
    shown, total = sessions[:5], len(sessions)
    label = f"latest {len(shown)} of {total}" if total > len(shown) else f"{total}"
    print(f"Sessions in {cwd} ({label}, newest first):\n")
    for path, provider, sid in shown:  # snippet read only for displayed sessions
        ts = _local_time(last_activity(path), zone=False)  # what it's sorted by
        snippet = first_user_snippet(path, provider)
        print(f"  {provider:<6}  {sid}  {ts}" + (f"  {snippet}" if snippet else ""))
    print("\nRe-run with one:  session-transcript <sessionId>")


def _explicit_sessions(ids: list[str], deep: bool
                       ) -> tuple[list[Session], dict[str, list[str]]]:
    """The sessions named on the command line (plus their chain with --deep)."""
    # Resolve every id before writing anything so a missing/ambiguous id fails
    # the whole run up front instead of leaving a half-written transcript.
    # Dedupe on the resolved file: the same session named twice (say by id and
    # by path) would only repeat a section.
    resolved: list[tuple[Path, str]] = []
    for session in ids:
        if not session.strip():  # e.g. an unset shell variable
            sys.exit("empty session id")
        if _is_current(session):
            session = current_session_id()
        path, provider = find_session_file(session)
        found = (path.resolve(), provider)
        if found not in resolved:
            resolved.append(found)

    sessions = [load_session(path, provider) for path, provider in resolved]
    parents: dict[str, list[str]] = {}
    if deep:
        sessions, parents = follow_lineage(sessions)
        if len(sessions) == len(resolved):
            print("--deep: no earlier sessions referenced", file=sys.stderr)
        # Oldest first, so a resume chain reads forward (chat 1, 2, 3) no
        # matter which end of it the caller happened to name.
        sessions.sort(key=session_start)
    return sessions, parents


def _at_least_one(text: str) -> int:
    """argparse type for --recent / --messages: a whole number, 1 or more."""
    try:
        value = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"expected a whole number, got {text!r}") from None
    if value < 1:
        raise argparse.ArgumentTypeError(f"must be 1 or more, got {value}")
    return value


def main() -> None:
    ap = argparse.ArgumentParser(
        add_help=True,
        # Abbreviations (`--sa` for --save) would slip past the export-flag
        # check that keeps exports out of --deep lineage; spell flags out.
        allow_abbrev=False,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=(
            "Emit a light Markdown transcript of a Claude Code or Codex "
            "session:\nthe human <-> assistant text plus a compact trace of "
            "which tools ran\nand what they touched. No LLM, no tokens, "
            "~instant."),
        epilog=(
            "modes:\n"
            "  session-transcript                       list this project's "
            "sessions, then exit\n"
            "  session-transcript <sessionId> [...]     write ONE transcript "
            "file\n"
            "  session-transcript this [...]            `this` = the session "
            "you run it from\n"
            "  session-transcript --recent N            this project's N most "
            "recent sessions,\n"
            "                                           in ONE file\n\n"
            "Sessions are scoped to the current directory. Lookup by id "
            "searches the\nClaude Code and Codex stores; the matching store "
            "selects the provider.\nA unique prefix of 8+ characters (the short "
            "id a recap shows) works too.\n\n"
            "Several ids are stitched into a single transcript, in the order "
            "given,\neach session under its own heading. --deep adds the "
            "sessions they were\nresumed from, transitively, oldest first: "
            "name the newest chat in a chain\nand get all of it.\n\n"
            "The transcript file path is printed as the LAST stdout line "
            "(read that\nfile). Default location is throwaway:\n"
            "  $TMPDIR/session-transcript/<sessionId>/summary.md    (one id)\n"
            "  $TMPDIR/session-transcript/<id1+id2+...>-<hash>/combined.md (several)\n\n"
            "--save keeps it in the project instead, under a name you can "
            "recognize\nin a repo listing:\n"
            "  transcripts/<date>-<opening prompt>.md      (--topic TEXT names it "
            "instead)\n"
            "Saving the same session(s) again overwrites that file; anything "
            "else\nalready there under the name (another session, any other "
            "file) is\nleft alone and the new one takes -2, -3, ...\n\n"
            "--out PATH (alias --to) writes to PATH exactly; if PATH is a "
            "directory\n(exists, or ends in /, created) the --save name goes "
            "inside it:\n"
            "  --out notes/  ->  notes/<date>-<opening prompt>.md\n\n"
            "--recent N takes the place of ids: the N most recent sessions in "
            "this\nproject, Claude Code and Codex together (or --provider "
            "claude|codex),\nnewest first by last recorded activity (not file "
            "mtime). Passed over:\n"
            "  - each --exclude ID: a full id, a unique prefix of 4+ chars (the "
            "8-char\n    short id works) or `this`; repeatable; one that matches no "
            "session, or\n    several, is reported on stderr and ignored\n"
            "  - sessions with no conversation at all\n"
            "  - sessions whose every prompt only ran /resume-lite, "
            "/recap-lite or\n    /export-lite (a bare listing, an earlier "
            "recap); one where the user\n    typed anything else, or ran "
            "another command, stays\n"
            "Fewer than N is fine; none is an error. It takes no ids and no "
            "--deep,\nand writes one recap file with a neutral header:\n"
            "  $TMPDIR/session-transcript/recent-<id1+id2+...>-<hash>/recent.md\n"
            "Kept with --save or --to DIR/, it's named like an export; one of "
            "the same\nfirst session takes -2 rather than replace it.\n\n"
            "--messages M keeps the first M and last M messages of each "
            "session and\nmarks the cut; a session with 2M or fewer is kept "
            "whole. A message is\none user prompt (## 👤 User), or the "
            "assistant's whole reply to it:\nevery ## 🤖 Claude / Codex and "
            "## 📋 Plan block up to the next prompt,\nwith their 🔧 tools "
            "lines (tools alone make a reply too). It needs ids\nor --recent. "
            "Trimmed temp files get -m<M> in their name (summary-m5.md,\n"
            "recent-m5.md), so they never replace a full one; a kept one is "
            "told apart\nby its header (see --save)."),
    )
    ap.add_argument("sessions", nargs="*", metavar="session",
                    help="session id(s), or `this` for the current session; "
                         "omit to list this project's sessions")
    where = ap.add_mutually_exclusive_group()
    where.add_argument("--out", "--to", dest="out", metavar="PATH",
                       help="write the transcript here instead of the default "
                            "path; a directory (existing, or ending in /) gets "
                            "the --save name inside it")
    where.add_argument("--save", action="store_true",
                       help=f"keep it in the project: {SAVE_DIR}/<date>-<topic>.md")
    ap.add_argument("--topic", metavar="TEXT",
                    help="with --save or --to DIR/: name the file after TEXT "
                         "instead of the opening prompt")
    ap.add_argument("--deep", action="store_true",
                    help="also pull in the sessions these were resumed from, "
                         "transitively (follows /resume-lite invocations)")
    ap.add_argument("--tools", dest="tools", action="store_true", default=True,
                    help="include the 🔧 tools trace (default)")
    ap.add_argument("--no-tools", dest="tools", action="store_false",
                    help="omit the tools trace (conversation only)")
    ap.add_argument("--stdout", action="store_true",
                    help="also print the transcript to stdout")
    ap.add_argument("--messages", type=_at_least_one, metavar="M",
                    help="keep only the first M and last M messages of each "
                         "session (see below for what a message is)")
    pick = ap.add_argument_group("recent sessions (instead of ids)")
    pick.add_argument("--recent", type=_at_least_one, metavar="N",
                      help="the N most recent sessions in this project, "
                           "newest first, in one file")
    pick.add_argument("--provider", choices=("claude", "codex"),
                      help="with --recent: only Claude Code or only Codex sessions")
    pick.add_argument("--exclude", action="append", default=[], metavar="ID",
                      help="with --recent: leave this session out (an id, a "
                           "unique prefix of one, or `this`); repeatable")
    args = ap.parse_args()
    keep = args.save or args.out is not None
    recent = args.recent is not None
    if args.out is not None and not args.out.strip():
        ap.error("--out/--to needs a path")
    if recent:
        if args.sessions:
            ap.error("--recent picks the sessions itself: give it no session ids")
        if args.deep:
            ap.error("--deep follows one conversation's resume chain; it "
                     "doesn't combine with --recent")
    elif args.provider or args.exclude:
        ap.error("--provider and --exclude only go with --recent")
    if args.topic is not None and not keep:
        ap.error("--topic names a kept transcript: use it with --save or --to DIR/")
    if (keep or args.messages) and not args.sessions and not recent:
        flags = "--save/--out/--to need" if keep else "--messages needs"
        ap.error(f"{flags} a session id or --recent "
                 "(run with no arguments to list this project's sessions)")

    if not args.sessions and not recent:
        print_session_list()
        return

    parents: dict[str, list[str]] = {}
    if recent:
        candidates = list_sessions()
        exclude, current = resolve_excludes(args.exclude, candidates)
        sessions, passed, summaries = recent_sessions(
            candidates, args.recent, args.provider, exclude)
        which = {"claude": "Claude Code ", "codex": "Codex "}.get(args.provider, "")
        if summaries:
            print(f"--recent: passed over {_plural(summaries, 'session')} that "
                  "only ran resume-lite, recap-lite or export-lite", file=sys.stderr)
        if not sessions:
            after = " (after --exclude)" if passed else ""
            sys.exit(f"--recent: no {which or 'Claude Code or Codex '}sessions "
                     f"to recap in {os.getcwd()}{after}")
        if len(sessions) < args.recent:
            print(f"--recent {args.recent}: only {_plural(len(sessions), 'session')}"
                  " found", file=sys.stderr)
        others = len([sid for sid in passed if sid != current])
        if current in passed:
            and_others = f" and {_plural(others, 'other')}" if others else ""
            excluding = f" (excluding the current session{and_others})"
        else:
            excluding = f" ({others} excluded)" if others else ""
    else:
        sessions, parents = _explicit_sessions(args.sessions, args.deep)

    # Trimmed temp files get their own name, so they never replace a full one.
    # (Kept ones don't need it: their header tells claim_name they differ.)
    suffix = f"-m{args.messages}" if args.messages else ""
    # A recap is read to be summarized, not continued: keep its header neutral.
    base = EXPORT_BLURB if args.tools else EXPORT_BLURB_NO_TOOLS
    blurb = base if keep or recent else base + RESUME_LINE
    if recent:
        title = (f"{len(sessions)} most recent {which}session"
                 + ("" if len(sessions) == 1 else "s"))
        blurb += f"\n> The {title} in this project, newest first{excluding}."
    if args.messages:
        blurb += (f"\n> Trimmed with --messages {args.messages}: the first and "
                  f"last {args.messages} messages of each session.")

    if recent:
        transcript = build_combined(sessions, args.tools, None, blurb,
                                    args.messages, title, last_active=True)
        default_out = combined_out_path([s.id for s in sessions], "recent", suffix)
    elif len(sessions) == 1:
        only = sessions[0]
        transcript = build_transcript(only.records, only.id, args.tools,
                                      only.provider, blurb, args.messages)
        default_out = OUT_ROOT / only.id / f"summary{suffix}.md"
    else:
        # Several sessions -> one stitched file: the caller is picking up one
        # conversation spread over sessions, so it should end up as one thing
        # to read, not N. Explicit ids keep argument order; --deep sorts.
        transcript = build_combined(sessions, args.tools, parents, blurb,
                                    args.messages)
        default_out = combined_out_path([s.id for s in sessions], suffix=suffix)

    # Why a file instead of just printing the transcript to stdout for the
    # invoking agent to consume: a full transcript can be large, and tool
    # stdout is truncated at the agent's output cap (and would dump the whole
    # thing into context at once). Writing a file lets the agent Read it with
    # pagination/offset and re-read spans on demand. Keep this file-first.
    if args.save:
        out = claim_name(save_out_path(sessions, topic=args.topic), transcript)
    elif args.out is not None:
        out = out_path(args.out, sessions, args.topic, transcript)
    else:
        out = default_out
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(transcript, encoding="utf-8")
    except OSError as exc:  # e.g. a parent that is a file, or no permission
        sys.exit(f"cannot write {out}: {exc.strerror or exc}")
    if args.stdout:
        print(transcript)
        print("\n---", file=sys.stderr)

    # Machine-readable last line: the transcript path the skill should read.
    print(out)


if __name__ == "__main__":
    main()
